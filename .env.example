PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/myDatabase?retryWrites=true&w=majority

# ========================================================
# Email & SMTP Configuration (For Forgot Password OTP & Notifications)
# ========================================================
# Option 1: Gmail SMTP (Use App Password from Google Account Security)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
SMTP_FROM="RN Master Class" <support@rnmasterclass.dev>

# Option 2: Custom Domain SMTP (e.g., mail.rnmasterclass.dev or Zoho / Brevo)
# SMTP_HOST=smtp.zoho.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=support@rnmasterclass.dev
# SMTP_PASS=your-mailbox-password
# SMTP_FROM="RN Master Class" <support@rnmasterclass.dev>
